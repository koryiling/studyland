# Copy to .env.local and fill in. Never commit .env.local.

# Built-in AI for all students (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: override the Gemini model
# GEMINI_MODEL=gemini-3.8-flash

# Optional backup when Gemini is busy or out of quota (free key: https://console.groq.com/keys).
# Only short requests (grading short answers, study plans) go to Groq: its free tier is ~8K tokens/minute.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
